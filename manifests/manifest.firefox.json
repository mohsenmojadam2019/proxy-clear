{
  "manifest_version": 3,
  "name": "Proxy Clear",
  "version": "1.0.0",
  "description": "Clear browser and Linux system proxy settings from one button.",
  "permissions": ["proxy", "nativeMessaging", "storage"],
  "action": {"default_title": "Proxy Clear", "default_popup": "popup.html"},
  "background": {"scripts": ["background.js"]},
  "browser_specific_settings": {"gecko": {"id": "proxy-clear@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}
}
