{
  "manifest_version": 3,
  "name": "Proxy Clear",
  "version": "1.0.0",
  "description": "Clear browser and Linux system proxy settings from one button.",
  "key": "__CHROME_KEY__",
  "permissions": ["proxy", "nativeMessaging", "storage"],
  "action": {"default_title": "Proxy Clear", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "minimum_chrome_version": "100"
}
